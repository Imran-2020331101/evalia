# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/evalia

# JWT Configuration
JWT_SECRET=<random string of at least 64 bytes>
JWT_EXPIRATION=86400000

# OAuth2 GitHub Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# Server Configuration
SERVER_PORT=8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary (profile/cover photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP) for OTP and notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_app_password
