{
  "name": "evalia-root-tests",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cross-service contract, smoke and e2e tests for Evalia (self-contained, offline by default)",
  "scripts": {
    "test": "vitest run",
    "test:contract": "vitest run contract",
    "test:smoke": "vitest run smoke",
    "test:e2e": "vitest run e2e",
    "stack:up": "docker compose -f docker-compose.test.yml up -d",
    "stack:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
